{
  "name": "vhdl-course-workbench-vivado",
  "displayName": "VHDL Course Workbench - Vivado Workflow",
  "description": "Vivado checking and synthesis workflow for the VHDL Course Workbench",
  "version": "0.0.3",
  "publisher": "ecng2007-local",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "P4B Experimental Development Prototype",
      "properties": {
        "p4b.experimental.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Opt in to experimental Vivado procedures. NOT official course workflows. Requires a trusted local Windows workspace."
        },
        "p4b.experimental.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to your installed Vivado launcher (.bat, .cmd or .exe). No quotes or command arguments."
        },
        "p4b.experimental.topLevel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Explicit basic VHDL entity name for experimental synthesis. No default is assumed."
        },
        "p4b.experimental.part": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Exact FPGA part installed and supported by your Vivado installation. Required for experimental synthesis; no default is assumed."
        }
      }
    },
    "commands": [
      {
        "command": "vhdl-course-workbench-vivado.runChecking",
        "title": "Vivado: Run Checking"
      },
      {
        "command": "vhdl-course-workbench-vivado.runSynthesis",
        "title": "Vivado: Run Synthesis"
      },
      {
        "command": "vhdl-course-workbench-vivado.openWorkflow",
        "title": "Vivado: Open Workflow Sidebar"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vivadoWorkflow",
          "title": "Vivado Workflow",
          "icon": "media/vivado.svg"
        }
      ]
    },
    "views": {
      "vivadoWorkflow": [
        {
          "type": "webview",
          "id": "p4b.vivadoWorkflow",
          "name": "Vivado Workflow"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test out/test/unit/*.test.js && vscode-test",
    "pretest:unit": "npm run compile",
    "test:unit": "node --test out/test/unit/*.test.js",
    "pretest:extension": "npm run compile",
    "test:extension": "vscode-test",
    "prepackage:experimental": "npm run compile && npm run lint",
    "package:experimental": "node scripts/package-experimental.cjs",
    "verify:package": "node scripts/verify-package.cjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.144.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
